# name: test/sql/coverage/r2/uc_04_how_far_off.test
# description: A heated-seat requirement says time to 37 °C at most 180 s. The engineer
#              lists every heating module with "misses by x %" so development knows how
#              much faster each one would have to be (BR-13).
# group: [coverage]

require anofox_similarity

statement ok
CREATE TABLE heaters AS SELECT * FROM (VALUES
    ('H-150', 150.0), ('H-183', 183.0), ('H-190', 190.0), ('H-240', 240.0)) t(module, time_to_temp_s);

# time is linear: d = (p - 180) / 180, tolerance 2 %, band 5 %
#   150: d 0                            -> 1,      'meets'
#   183: d 0.0167 <= 0.02               -> 1,      'meets (within tolerance)'
#   190: d 0.0556 -> 1 - 0.0356/0.05    -> 0.2889, misses by 5.6 %
#   240: d 0.3333                       -> 0,      misses by 33.3 %
query TRT
SELECT module, round(v.score, 4),
       CASE WHEN v.distance = 0 THEN 'meets'
            WHEN v.score = 1 THEN 'meets (within tolerance)'
            ELSE 'misses by ' || round(100 * v.distance, 1) || ' %' END AS verdict
FROM heaters,
     LATERAL (SELECT value_satisfies(parse_quantity('max. 180 s'),
                                     {'lo': time_to_temp_s, 'hi': time_to_temp_s, 'dimension': 'time'}) AS v)
ORDER BY module;
----
H-150	1.0	meets
H-183	1.0	meets (within tolerance)
H-190	0.2889	misses by 5.6 %
H-240	0.0	misses by 33.3 %

# The same limit given in minutes: 3 min = 180 s
query R
SELECT parse_quantity('max. 3 min').lo;
----
180.0
