# name: test/sql/coverage/r2/uc_05_ordinal_classes.test
# description: Trim and wiring requirements state classes ("flammability class F1 or
#              better", "IP54 or better"). Compatibility comes from the curated rules table,
#              not from text similarity (BR-15).
# group: [coverage]

require anofox_similarity

statement ok
CREATE TABLE compatibility_rules AS
SELECT * FROM read_csv_auto('test/data/coverage/compatibility_rules.csv.gz');

statement ok
CREATE TABLE offers AS SELECT * FROM (VALUES
    ('W1', 'protection_class', 'IP65'), ('W2', 'protection_class', 'IP54'), ('W3', 'protection_class', 'IP40'),
    ('T1', 'flammability_class', 'F0'), ('T2', 'flammability_class', 'F2')) t(offer_id, dimension, provided);

statement ok
CREATE TABLE requirements AS SELECT * FROM (VALUES
    ('protection_class', 'IP54 or better'), ('flammability_class', 'Brennbarkeitsklasse F1 oder besser'))
    t(dimension, value_text);

# IP54 required: IP65 1, IP54 1, IP40 two steps worse 0
# F1 required (F3 < F2 < F1 < F0): F0 1, F2 one step worse 0.5
query TTR
SELECT o.offer_id, parse_quantity(r.value_text).category,
       compat_score(r.dimension, parse_quantity(r.value_text).category, o.provided)
FROM requirements r JOIN offers o USING (dimension)
ORDER BY o.offer_id;
----
T1	F1	1.0
T2	F1	0.5
W1	IP54	1.0
W2	IP54	1.0
W3	IP54	0.0
