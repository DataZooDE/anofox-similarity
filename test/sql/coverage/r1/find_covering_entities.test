# name: test/sql/coverage/r1/find_covering_entities.test
# description: find_covering_entities / find_covering_entities_for (HLD §4.1) on the
#              hand-made mini fixture. All expected values are computed by hand.
# group: [coverage]

require anofox_similarity

statement ok
CREATE TABLE ms AS SELECT * FROM read_csv_auto('test/data/coverage/mini/feature_multiset.csv');

# Mini programmes (class -> weight):
#   S1 heat 2, massage 4, headrest 1, memory 1, track 1           Σ 9
#   S2 heat 2, massage 4, headrest 1, memory 1                    Σ 8
#   S3 heat 2, massage 2, headrest 1                              Σ 5
#   S4 heat 4, ventilation 2                                      Σ 6
#   S5 track 1, memory 1                                          Σ 2
#   S6 heat 2, ventilation 2, massage 4, headrest 1, memory 1, track 2   Σ 12
#
# Query S2 (Σq = 8), candidates = entities sharing a feature, S2 itself excluded:
#   S1: Σmin 8 -> containment 8/8 = 1, jaccard 8/(8+9-8) = 0.889, surplus 9-8 = 1
#   S6: Σmin 8 -> containment 1,       jaccard 8/(8+12-8) = 0.667, surplus 4
#   S3: Σmin 2+2+1 = 5 -> 0.625,        jaccard 5/(8+5-5) = 0.625, surplus 0
#   S4: Σmin 2 -> 0.25,                 jaccard 2/(8+6-2) = 0.167, surplus 4
#   S5: Σmin 1 -> 0.125,                jaccard 1/(8+2-1) = 0.111, surplus 1
# score = containment + 0.01 * jaccard: S1 1.00889, S6 1.00667, S3 0.63125, S4 0.25167, S5 0.12611

query TRRRRRRR
SELECT entity_id, round(score, 3), round(containment, 3), round(jaccard, 3),
       shared_weight, query_weight, candidate_weight, surplus_weight
FROM find_covering_entities('S2', 3, feature_table := 'ms');
----
S1	1.009	1.0	0.889	8.0	8.0	9.0	1.0
S6	1.007	1.0	0.667	8.0	8.0	12.0	4.0
S3	0.631	0.625	0.625	5.0	8.0	5.0	0.0

query TR
SELECT entity_id, round(score, 3) FROM find_covering_entities('S2', 10, feature_table := 'ms');
----
S1	1.009
S6	1.007
S3	0.631
S4	0.252
S5	0.126

# mode := 'jaccard' ranks by weighted Jaccard alone: S1 0.889, S6 0.667, S3 0.625
query TR
SELECT entity_id, round(score, 3) FROM find_covering_entities('S2', 3, mode := 'jaccard', feature_table := 'ms');
----
S1	0.889
S6	0.667
S3	0.625

# mode := 'tversky' with alpha 1, beta 0.5: Σmin/(Σmin + 1*missing + 0.5*surplus) + 0.01*jaccard
#   S1 8/(8+0+0.5) = 0.94118 + 0.00889 = 0.95007
#   S6 8/(8+0+2)   = 0.8     + 0.00667 = 0.80667
#   S3 5/(5+3+0)   = 0.625   + 0.00625 = 0.63125
query TR
SELECT entity_id, round(score, 3)
FROM find_covering_entities('S2', 3, mode := 'tversky', alpha := 1.0, beta := 0.5, feature_table := 'ms');
----
S1	0.95
S6	0.807
S3	0.631

# weighted := false compares distinct features: |q| = 4
#   S1 4/4 = 1, jaccard 4/5 = 0.8 -> 1.008;  S6 1, 4/6 -> 1.00667;  S3 3/4 = 0.75, 3/4 -> 0.7575
query TRRR
SELECT entity_id, round(score, 4), containment, round(jaccard, 4)
FROM find_covering_entities('S2', 3, weighted := false, feature_table := 'ms');
----
S1	1.008	1.0	0.8
S6	1.0067	1.0	0.6667
S3	0.7575	0.75	0.75

# min_score filters on the measure itself (containment here), before the tie-break
query T
SELECT entity_id FROM find_covering_entities('S2', 10, min_score := 0.5, feature_table := 'ms');
----
S1
S6
S3

# min_score compares the measure, not the score: S3 has containment 0.625 < 0.63
# although its score (0.63125) is above it
query T
SELECT entity_id FROM find_covering_entities('S2', 10, min_score := 0.63, feature_table := 'ms');
----
S1
S6

# tie_break := 0 leaves full covers tied; ties are broken by entity_id
query TR
SELECT entity_id, score FROM find_covering_entities('S2', 2, tie_break := 0.0, feature_table := 'ms');
----
S1	1.0
S6	1.0

# only candidates that share a feature are returned (S7 has only an armrest)
statement ok
CREATE TABLE ms2 AS SELECT * FROM ms UNION ALL SELECT 'S7', 'armrest', 1.0;

query I
SELECT count(*) FROM find_covering_entities('S2', 10, feature_table := 'ms2') WHERE entity_id = 'S7';
----
0

# mode is case-insensitive, and NULL means the default
query T
SELECT entity_id FROM find_covering_entities('S2', 1, mode := 'Containment', feature_table := 'ms');
----
S1

query T
SELECT entity_id FROM find_covering_entities('S2', 1, mode := NULL, feature_table := 'ms');
----
S1

# tversky with its defaults (alpha 1, beta 0) is containment
query I
SELECT count(*) FROM (
    SELECT entity_id, score FROM find_covering_entities('S2', 5, mode := 'tversky', feature_table := 'ms')
    EXCEPT SELECT entity_id, score FROM find_covering_entities('S2', 5, feature_table := 'ms'));
----
0

# weighted := false: the *_weight columns count distinct features
#   S2 = 4 features; S1 shares 4 of its 5; S6 shares 4 of its 6
query TRRRR
SELECT entity_id, shared_weight, query_weight, candidate_weight, surplus_weight
FROM find_covering_entities('S2', 2, weighted := false, feature_table := 'ms');
----
S1	4.0	4.0	5.0	1.0
S6	4.0	4.0	6.0	2.0

# rows with a NULL entity or feature are ignored
statement ok
CREATE TABLE ms3 AS SELECT * FROM ms UNION ALL SELECT NULL, 'massage', 9.0 UNION ALL SELECT 'S1', NULL, 9.0;

query TR
SELECT entity_id, candidate_weight FROM find_covering_entities('S2', 1, feature_table := 'ms3');
----
S1	9.0

# an unknown query entity has no candidates
query I
SELECT count(*) FROM find_covering_entities('NOPE', 5, feature_table := 'ms');
----
0

# ---------------------------------------------------------------- query by value

# The request is not in the table. Q = S2's multiset, so S2 itself now ranks first
# with containment 1 and jaccard 1: score 1.01
query TRR
SELECT entity_id, round(score, 3), round(jaccard, 3)
FROM find_covering_entities_for(MAP {'seat_heating': 2, 'massage': 4, 'headrest_powered': 1, 'memory_module': 1},
                                3, feature_table := 'ms');
----
S2	1.01	1.0
S1	1.009	0.889
S6	1.007	0.667

# an empty, NULL, all-zero or unknown request matches nothing
query IIII
SELECT (SELECT count(*) FROM find_covering_entities_for(MAP {}::MAP(VARCHAR, DOUBLE), 5, feature_table := 'ms')),
       (SELECT count(*) FROM find_covering_entities_for(NULL::MAP(VARCHAR, DOUBLE), 5, feature_table := 'ms')),
       (SELECT count(*) FROM find_covering_entities_for(MAP {'massage': 0}, 5, feature_table := 'ms')),
       (SELECT count(*) FROM find_covering_entities_for(MAP {'cupholder': 1}, 5, feature_table := 'ms'));
----
0	0	0	0

# request keys are data, not SQL: a hostile key is just an unknown feature
#   request {hostile: 1, massage: 4}, Σq 5: S1, S2, S6 have 4 massage zones -> containment 0.8;
#   jaccard S2 4/(5+8-4) = 0.444 > S1 4/(5+9-4) = 0.4 > S6 4/(5+12-4) = 0.308
query TR
SELECT entity_id, containment FROM find_covering_entities_for(MAP {'it''s; DROP TABLE ms --': 1, 'massage': 4}, 1,
                                                              feature_table := 'ms');
----
S2	0.8

query I
SELECT count(*) FROM ms;
----
22

# weighted := false ignores the request counts: {massage} is in S3 although S3 has 2 zones
query TR
SELECT entity_id, containment FROM find_covering_entities_for(MAP {'massage': 4}, 10, weighted := false,
                                                              feature_table := 'ms')
WHERE entity_id = 'S3';
----
S3	1.0

statement error
SELECT * FROM find_covering_entities_for(MAP {'massage': -1}, 5, feature_table := 'ms');
----
weights must be non-negative

statement error
SELECT * FROM find_covering_entities_for(['massage'], 5, feature_table := 'ms');
----
query must be a MAP

# A known limitation of the additive tie-break (HLD §4.1, kept by decision of 2026-10-25):
# a near-complete partial cover can outrank a full but much larger cover.
#   request {f1: 199, f2: 1} (Σ 200)
#   A = {f1: 199}:          containment 199/200 = 0.995, jaccard 199/200 = 0.995 -> 1.00495
#   B = {f1: 199, f2: 801}: containment 1,               jaccard 200/1000 = 0.2  -> 1.002
statement ok
CREATE TABLE edge(entity_id VARCHAR, feature_id VARCHAR, weight DOUBLE);

statement ok
INSERT INTO edge VALUES ('A', 'f1', 199), ('B', 'f1', 199), ('B', 'f2', 801);

query TRR
SELECT entity_id, round(score, 5), containment
FROM find_covering_entities_for(MAP {'f1': 199, 'f2': 1}, 2, feature_table := 'edge');
----
A	1.00495	0.995
B	1.002	1.0

# ---------------------------------------------------------------- column mapping

# an existing BOM-like table maps through entity_col / feature_col / weight_col
statement ok
CREATE TABLE assembly_parts(assembly VARCHAR, part VARCHAR, qty DOUBLE);

statement ok
INSERT INTO assembly_parts VALUES
    ('A1', 'bolt', 4), ('A1', 'bracket', 2),
    ('A2', 'bolt', 8), ('A2', 'bracket', 2), ('A2', 'cover', 1),
    ('A3', 'bolt', 2), ('A3', 'bracket', 2);

# query A1 (Σq 6): A2 Σmin 4+2 = 6 -> 1.0, jaccard 6/(6+11-6) = 0.545 -> 1.00545
#                  A3 Σmin 2+2 = 4 -> 0.667, jaccard 4/(6+4-4) = 0.667 -> 0.67333
query TRR
SELECT entity_id, round(score, 4), round(containment, 4)
FROM find_covering_entities('A1', 5, feature_table := 'assembly_parts',
                            entity_col := 'assembly', feature_col := 'part', weight_col := 'qty');
----
A2	1.0055	1.0
A3	0.6733	0.6667

# NULL weights count as 1, duplicate rows add up
statement ok
INSERT INTO assembly_parts VALUES ('A4', 'bolt', NULL), ('A4', 'bolt', 3), ('A4', 'bracket', NULL);

# A4 = {bolt: 1+3 = 4, bracket: 1}: Σmin with A1 = 4+1 = 5 -> 5/6
query TR
SELECT entity_id, round(containment, 4)
FROM find_covering_entities('A1', 5, feature_table := 'assembly_parts',
                            entity_col := 'assembly', feature_col := 'part', weight_col := 'qty')
WHERE entity_id = 'A4';
----
A4	0.8333

# a table without a weight column: weight_col := NULL means unit weights
statement ok
CREATE TABLE bom_items(parent_id VARCHAR, child_id VARCHAR);

statement ok
INSERT INTO bom_items VALUES ('D1','a'), ('D1','b'), ('D2','a'), ('D2','b'), ('D2','c'), ('D3','a');

# D1 = {a,b}: D2 contains both (jaccard 2/3), D3 one (containment 0.5, jaccard 0.5)
query TRR
SELECT entity_id, containment, round(jaccard, 4)
FROM find_covering_entities('D1', 5, feature_table := 'bom_items', entity_col := 'parent_id',
                            feature_col := 'child_id', weight_col := NULL);
----
D2	1.0	0.6667
D3	0.5	0.5

# ---------------------------------------------------------------- errors

statement error
SELECT * FROM find_covering_entities('S2', 3, feature_table := 'ms; DROP TABLE ms');
----
Invalid identifier for feature_table

statement error
SELECT * FROM find_covering_entities('S2', 3, feature_table := 'ms', entity_col := 'x y');
----
Invalid identifier for entity_col

statement error
SELECT * FROM find_covering_entities('S2', 3, feature_table := 'ms', entity_col := 'tree');
----
missing required column(s): tree

statement error
SELECT * FROM find_covering_entities('S2', 3, mode := 'cosine', feature_table := 'ms');
----
mode must be one of 'jaccard', 'containment', 'tversky'

statement error
SELECT * FROM find_covering_entities('S2', NULL, feature_table := 'ms');
----
k must not be NULL

statement error
SELECT * FROM find_covering_entities('S2', 0, feature_table := 'ms');
----
k must be positive

statement error
SELECT * FROM find_covering_entities('S2', -3, feature_table := 'ms');
----
k must be positive

statement error
SELECT * FROM find_covering_entities(NULL, 3, feature_table := 'ms');
----
query_entity_id must not be NULL

statement error
SELECT * FROM find_covering_entities('S2', 3, mode := 'tversky', beta := -0.1, feature_table := 'ms');
----
alpha and beta must be non-negative

statement error
SELECT * FROM find_covering_entities('S2', 3, mode := 'tversky', alpha := -1.0, feature_table := 'ms');
----
alpha and beta must be non-negative

statement ok
CREATE TABLE neg AS SELECT * FROM (VALUES ('E1', 'f', -2.0), ('E2', 'f', 1.0)) t(entity_id, feature_id, weight);

statement error
SELECT * FROM find_covering_entities('E1', 3, feature_table := 'neg');
----
weights must be non-negative

# the check covers the whole table, not only the query and its candidates
statement ok
INSERT INTO neg VALUES ('E3', 'g', 1.0), ('E4', 'g', 1.0);

statement error
SELECT * FROM find_covering_entities('E3', 3, feature_table := 'neg');
----
weights must be non-negative

# the default feature table is feature_multiset
statement ok
CREATE TABLE feature_multiset AS SELECT * FROM ms;

query T
SELECT entity_id FROM find_covering_entities('S2', 1);
----
S1
