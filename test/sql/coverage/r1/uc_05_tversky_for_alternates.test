# name: test/sql/coverage/r1/uc_05_tversky_for_alternates.test
# description: Procurement looks for second-source programmes. Missing functions are
#              unacceptable, extra functions only cost a little. Tversky with alpha 1 and a
#              small beta expresses that; the engineer compares it with plain containment.
# group: [coverage]

require anofox_similarity

statement ok
CREATE TABLE prog_classes AS
SELECT * FROM read_csv_auto('test/data/coverage/mini/feature_multiset.csv');

# Reference programme S3 = {heat 2, massage 2, headrest 1}, Σ 5. Candidates:
#   S1 {heat 2, massage 4, headrest 1, memory 1, track 1}: Σmin 5, missing 0, surplus 4
#   S2 {heat 2, massage 4, headrest 1, memory 1}:          Σmin 5, missing 0, surplus 3
#   S6 {heat 2, vent 2, massage 4, headrest 1, memory 1, track 2}: Σmin 5, missing 0, surplus 7
#   S4 {heat 4, vent 2}:                                   Σmin 2, missing 3, surplus 4
# tversky(alpha 1, beta 0.1) = Σmin / (Σmin + 1*missing + 0.1*surplus)
#   S2 5/5.3 = 0.9434;  S1 5/5.4 = 0.9259;  S6 5/5.7 = 0.8772;  S4 2/(2+3+0.4) = 0.3704
# (plus 0.01 * jaccard as tie-break, which does not change the order here)
query TR
SELECT entity_id, round(score - 0.01 * jaccard, 4)
FROM find_covering_entities('S3', 4, mode := 'tversky', alpha := 1.0, beta := 0.1, feature_table := 'prog_classes');
----
S2	0.9434
S1	0.9259
S6	0.8772
S4	0.3704

# With containment all three full covers tie at 1 and only the tie-break separates them;
# with Tversky the surplus is part of the score itself, so a threshold can use it:
query T
SELECT entity_id
FROM find_covering_entities('S3', 4, mode := 'tversky', alpha := 1.0, beta := 0.1,
                            min_score := 0.9, feature_table := 'prog_classes');
----
S2
S1

query I
SELECT count(*) FROM find_covering_entities('S3', 4, min_score := 0.9, feature_table := 'prog_classes');
----
3

# The scalar gives the same number for a pair, for use in custom queries:
# S3 as a multiset vs S2: 5/(5 + 0 + 0.1*3) = 0.9434
query R
SELECT round(weighted_tversky(MAP {'seat_heating': 2, 'massage': 2, 'headrest_powered': 1},
                              MAP {'seat_heating': 2, 'massage': 4, 'headrest_powered': 1, 'memory_module': 1},
                              1.0, 0.1), 4);
----
0.9434
