# name: test/sql/coverage/r1/readonly.test
# description: The coverage search functions inline their SQL, so they work on a
#              read-only database (HLD §6).
# group: [coverage]

require anofox_similarity

load __TEST_DIR__/coverage_r1_readonly.db

statement ok
CREATE TABLE feature_multiset AS SELECT * FROM read_csv_auto('test/data/coverage/mini/feature_multiset.csv');

load __TEST_DIR__/coverage_r1_readonly.db readonly

statement ok
LOAD anofox_similarity

statement error
CREATE TABLE proof_readonly(x INTEGER);
