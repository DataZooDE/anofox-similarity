# name: test/sql/coverage/r3/uc_10_index_the_archive_once.test
# description: The archive is large and changes rarely; the team indexes its class multisets once
#              (tree_class_multiset) and ranks requests against the index. Stage 1 then skips
#              resolving every archive tree, and the results are identical (HLD §4.1, §4.7).
# group: [coverage]

require anofox_similarity

# The open requests: items labelled by upstream extraction, values parsed from the text
statement ok
CREATE TABLE requests AS SELECT * FROM read_csv_auto('test/data/coverage/requests.csv.gz');

statement ok
CREATE TABLE req_nodes AS
SELECT n.* EXCLUDE (class_id), g.class_id
FROM read_csv_auto('test/data/coverage/request_nodes.csv.gz') n
LEFT JOIN read_csv_auto('test/data/coverage/gold_item_class.csv.gz') g USING (tree_id, node_id);

statement ok
CREATE TABLE req_attrs AS
SELECT tree_id, node_id, attr_id, name, q.dimension, q.unit, q.lo, q.hi, q.bound, q.category
FROM (SELECT a.*, parse_quantity(a.value_text, r.lang) AS q
      FROM read_csv_auto('test/data/coverage/request_attributes.csv.gz') a
      JOIN requests r ON r.request_id = a.tree_id);

# The programme archive and the finished review of its internal vocabulary
statement ok
CREATE TABLE prog_nodes AS SELECT * FROM read_csv_auto('test/data/coverage/programme_nodes.csv.gz');

statement ok
CREATE TABLE prog_attrs AS SELECT * FROM read_csv_auto('test/data/coverage/programme_attributes.csv.gz');

statement ok
CREATE TABLE vocabulary_overrides AS
SELECT wording, source, class_id FROM read_csv_auto('test/data/coverage/gold_vocabulary.csv.gz');

# Catalogue templates (default bounds), compatibility rules, attribute-name vectors
statement ok
CREATE TABLE templates AS SELECT * FROM read_csv_auto('test/data/coverage/catalogue_attributes.csv.gz');

statement ok
CREATE TABLE compatibility_rules AS SELECT * FROM read_csv_auto('test/data/coverage/compatibility_rules.csv.gz');

statement ok
CREATE TABLE name_vectors AS
SELECT name, vec::FLOAT[] AS vec FROM read_csv_auto('test/data/coverage/attribute_name_vectors.csv.gz');

statement ok
SET VARIABLE name_floor = (SELECT median(list_cosine_similarity(a.vec, b.vec))
                           FROM name_vectors a, name_vectors b WHERE a.name < b.name);

statement ok
SET VARIABLE request_ids = (SELECT list(request_id ORDER BY request_id) FROM requests);

# Ground truth, for checking only
statement ok
CREATE TABLE gold AS SELECT * FROM read_csv_auto('test/data/coverage/gold_coverage.csv.gz');

statement ok
CREATE TABLE gold_requests AS SELECT * FROM read_csv_auto('test/data/coverage/gold_requests.csv.gz');

# index the archive once
statement ok
CREATE TABLE prog_index AS SELECT * FROM tree_class_multiset('prog_nodes', overrides_table := 'vocabulary_overrides');

query I
SELECT count(DISTINCT entity_id) FROM prog_index;
----
300

# stage 1 against the index ranks exactly as against the trees
statement ok
CREATE TABLE recall_trees AS SELECT * FROM coverage_recall(getvariable('request_ids'), k := 20, nodes_table := 'req_nodes',
       candidate_nodes_table := 'prog_nodes', overrides_table := 'vocabulary_overrides');

statement ok
CREATE TABLE recall_index AS SELECT * FROM coverage_recall(getvariable('request_ids'), k := 20, nodes_table := 'req_nodes',
       candidate_nodes_table := 'prog_nodes', overrides_table := 'vocabulary_overrides',
       candidate_multiset_table := 'prog_index');

query III
SELECT (SELECT count(*) FROM recall_index),
       (SELECT count(*) FROM (SELECT query_id, candidate_id, rank, round(score, 9), mode_used FROM recall_trees
                              EXCEPT SELECT query_id, candidate_id, rank, round(score, 9), mode_used FROM recall_index)),
       (SELECT count(*) FROM (SELECT query_id, candidate_id, rank, round(score, 9), mode_used FROM recall_index
                              EXCEPT SELECT query_id, candidate_id, rank, round(score, 9), mode_used FROM recall_trees));
----
1600	0	0

# and so does the full ranking
statement ok
CREATE TABLE ranked_index AS SELECT * FROM tree_coverage(getvariable('request_ids'), k := 20,
       nodes_table := 'req_nodes', attrs_table := 'req_attrs',
       candidate_nodes_table := 'prog_nodes', candidate_attrs_table := 'prog_attrs',
       overrides_table := 'vocabulary_overrides', default_bounds := 'catalogue', templates_table := 'templates',
       rules_table := 'compatibility_rules', name_vectors := 'name_vectors', name_floor := getvariable('name_floor'),
       candidate_multiset_table := 'prog_index');

statement ok
CREATE TABLE ranked_trees AS SELECT * FROM tree_coverage(getvariable('request_ids'), k := 20,
       nodes_table := 'req_nodes', attrs_table := 'req_attrs',
       candidate_nodes_table := 'prog_nodes', candidate_attrs_table := 'prog_attrs',
       overrides_table := 'vocabulary_overrides', default_bounds := 'catalogue', templates_table := 'templates',
       rules_table := 'compatibility_rules', name_vectors := 'name_vectors', name_floor := getvariable('name_floor'));

query II
SELECT (SELECT count(*) FROM (SELECT query_id, candidate_id, rank, round(coverage, 9), n_gaps FROM ranked_trees
                              EXCEPT SELECT query_id, candidate_id, rank, round(coverage, 9), n_gaps FROM ranked_index)),
       (SELECT count(*) FROM (SELECT query_id, candidate_id, rank, round(coverage, 9), n_gaps FROM ranked_index
                              EXCEPT SELECT query_id, candidate_id, rank, round(coverage, 9), n_gaps FROM ranked_trees));
----
0	0

# the index needs entity_id, feature_id and weight
statement ok
CREATE TABLE bad_index AS SELECT entity_id, feature_id FROM prog_index;

statement error
SELECT * FROM coverage_recall('R01', nodes_table := 'req_nodes', candidate_nodes_table := 'prog_nodes',
                              candidate_multiset_table := 'bad_index');
----
weight
