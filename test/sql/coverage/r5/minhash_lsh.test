# name: test/sql/coverage/r5/minhash_lsh.test
# description: Sub-linear recall accelerators (HLD §4.7): weighted MinHash (ICWS) signatures
#              estimate weighted Jaccard; LSH bands find candidates; containment is derived
#              from the Jaccard estimate and the set sizes. Exact recall stays the default.
# group: [coverage]

require anofox_similarity

query I
SELECT len(weighted_minhash(MAP {'a': 1.0, 'b': 2.0}, 64));
----
64

# identical multisets share every sample; disjoint ones none
query RR
SELECT minhash_similarity(weighted_minhash(MAP {'a': 1.0, 'b': 2.0}, 128), weighted_minhash(MAP {'a': 1.0, 'b': 2.0}, 128)),
       minhash_similarity(weighted_minhash(MAP {'a': 1.0}, 128), weighted_minhash(MAP {'b': 1.0}, 128));
----
1.0	0.0

# the estimate is close to the exact weighted Jaccard (256 samples)
statement ok
CREATE TABLE ms AS SELECT i, map_from_entries([('f' || (j % 13), 1.0 + ((i * 7 + j) % 5)::DOUBLE) FOR j IN range(i % 9 + 3)]) AS m
FROM range(40) t(i);

query I
SELECT avg(abs(minhash_similarity(weighted_minhash(a.m, 256), weighted_minhash(b.m, 256)) - weighted_jaccard(a.m, b.m))) < 0.05
FROM ms a, ms b WHERE a.i < b.i;
----
true

# weights matter: {a 1, b 1} vs {a 1, b 3} has weighted Jaccard 2 / 4 = 0.5
query T
SELECT abs(minhash_similarity(weighted_minhash(MAP {'a': 1.0, 'b': 1.0}, 1024), weighted_minhash(MAP {'a': 1.0, 'b': 3.0}, 1024)) - 0.5) < 0.06;
----
true

# a zero weight is absent; a NULL weight counts as 1 (as in weighted_jaccard)
query TT
SELECT weighted_minhash(MAP {'a': 1.0, 'b': 0.0}, 32) = weighted_minhash(MAP {'a': 1.0}, 32),
       weighted_minhash(map_from_entries([('a', 1.0::DOUBLE), ('b', NULL)]), 32) = weighted_minhash(MAP {'a': 1.0, 'b': 1.0}, 32);
----
true	true

# the same seed gives the same signature
query I
SELECT weighted_minhash(MAP {'a': 1.0}, 16, 7) = weighted_minhash(MAP {'a': 1.0}, 16, 7)
   AND weighted_minhash(MAP {'a': 1.0}, 16, 7) <> weighted_minhash(MAP {'a': 1.0}, 16, 8);
----
true

query II
SELECT weighted_minhash(NULL, 16) IS NULL, weighted_minhash(MAP {}::MAP(VARCHAR, DOUBLE), 16) IS NULL;
----
true	true

statement error
SELECT weighted_minhash(MAP {'a': -1.0}, 16);
----
must not be negative

# bands: one hash per band of rows = num_hashes / bands
query I
SELECT len(lsh_bands(weighted_minhash(MAP {'a': 1.0}, 64), 16));
----
16

statement error
SELECT lsh_bands(weighted_minhash(MAP {'a': 1.0}, 64), 5);
----
divisible

statement error
SELECT minhash_similarity(weighted_minhash(MAP {'a': 1.0}, 16), weighted_minhash(MAP {'a': 1.0}, 32));
----
same length

# ---------------------------------------------------------------- index and search

statement ok
CREATE TABLE feature_multiset AS SELECT * FROM read_csv_auto('test/data/coverage/mini/feature_multiset.csv');

# the index keeps one signature per entity and band hashes for 1, 2, 4 and 8 rows per band
# (LSH-Ensemble style, HLD §4.7): 64 + 32 + 16 + 8 = 120 band hashes at 64 hashes
statement ok
CREATE TABLE idx AS SELECT * FROM minhash_index(feature_table := 'feature_multiset', num_hashes := 64);

query TT
SELECT count(*) = (SELECT count(DISTINCT entity_id) FROM feature_multiset), bool_and(len(signature) = 64 AND len(band_hashes) = 120)
FROM idx;
----
true	true

# a query equal to an entity finds it with estimate 1
statement ok
CREATE TABLE queries AS SELECT 'S2' AS query_id, feature_id, weight FROM feature_multiset WHERE entity_id = 'S2';

query TTR
SELECT query_id, entity_id, jaccard_estimate FROM find_covering_entities_lsh('queries', 'idx', k := 5, mode := 'jaccard')
WHERE entity_id = 'S2';
----
S2	S2	1.0

# containment: the estimate is J (|q| + |c|) / ((1 + J) |q|), capped at 1
query T
SELECT bool_and(abs(l.estimate - least(1, l.jaccard_estimate * (q.total + i.total_weight) / ((1 + l.jaccard_estimate) * q.total))) < 1e-12)
FROM find_covering_entities_lsh('queries', 'idx', k := 5) l
JOIN idx i USING (entity_id) JOIN (SELECT query_id, sum(weight) AS total FROM queries GROUP BY ALL) q USING (query_id);
----
true

# at most k rows per query, and the number of candidates scored
query TT
SELECT count(*) <= 2, bool_and(n_candidates >= count) FROM (
    SELECT n_candidates, count(*) OVER () AS count FROM find_covering_entities_lsh('queries', 'idx', k := 2));
----
true	true

# a small query inside a large candidate: plain Jaccard banding misses it (J = 2/30), the size
# partitions choose one row per band for the large partition and find it
statement ok
CREATE TABLE big_small AS
SELECT 'big' AS entity_id, 'f' || i AS feature_id, 1.0 AS weight FROM range(30) t(i)
UNION ALL SELECT 'other', 'g' || i, 1.0 FROM range(30) t(i)
UNION ALL SELECT 'tiny', 'h' || i, 1.0 FROM range(2) t(i);

statement ok
CREATE TABLE bs_idx AS SELECT * FROM minhash_index(feature_table := 'big_small', num_hashes := 128, partitions := 2);

statement ok
CREATE TABLE small_q AS SELECT 'q' AS query_id, 'f' || i AS feature_id, 1.0 AS weight FROM range(2) t(i);

query TT
SELECT entity_id, estimate > 0.5 FROM find_covering_entities_lsh('small_q', 'bs_idx', k := 1, threshold := 0.5);
----
big	true

statement error
SELECT * FROM find_covering_entities_lsh('queries', 'idx', mode := 'bogus');
----
mode must be 'containment' or 'jaccard'
