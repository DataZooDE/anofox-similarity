# name: test/sql/coverage/r5/evaluation.test
# description: Evaluation and calibration (HLD §4.8): ranking metrics, calibration of the
#              predicted coverage, the auto-accept threshold, cluster bootstrap intervals and the
#              grid fit of the kernel weights, on hand-made fixtures.
# group: [coverage]

require anofox_similarity

# ---------------------------------------------------------------- eval_ranking

# gold: q1 c1 0.9, c2 1.0, c3 0.5 (best c2); q2 d1 0.8, d2 0.8, d3 0.3 (best d1 and d2)
statement ok
CREATE TABLE gold AS SELECT * FROM (VALUES
    ('q1', 'c1', 0.9::DOUBLE), ('q1', 'c2', 1.0), ('q1', 'c3', 0.5),
    ('q2', 'd1', 0.8), ('q2', 'd2', 0.8), ('q2', 'd3', 0.3)) t(query_id, candidate_id, true_coverage);

# results: q1 ranks c1, c2, c3; q2 ranks d3, d1, d2
statement ok
CREATE TABLE results AS SELECT * FROM (VALUES
    ('q1', 'c1', 1, 0.95::DOUBLE), ('q1', 'c2', 2, 0.9), ('q1', 'c3', 3, 0.4),
    ('q2', 'd3', 1, 0.7), ('q2', 'd1', 2, 0.6), ('q2', 'd2', 3, 0.5)) t(query_id, candidate_id, rank, coverage);

# k = 1: no best first. k = 2: both have a best in the top 2; recall (1 + 1/2) / 2 = 0.75;
# reciprocal rank 1/2 for both -> MRR 0.5. k = 3: recall 1. Regret (0.1 + 0.5) / 2 = 0.3, none <= 0.05
query IIRRRRR
SELECT k, n_queries, top_k_accuracy, recall_at_k, mrr, round(mean_regret, 6), share_regret_le_005
FROM eval_ranking('results', 'gold', k := [1, 2, 3]) ORDER BY k;
----
1	2	0.0	0.0	0.0	0.3	0.0
2	2	1.0	0.75	0.5	0.3	0.0
3	2	1.0	1.0	0.5	0.3	0.0

# without a rank column the score orders the candidates (highest first)
statement ok
CREATE TABLE scored_only AS SELECT query_id, candidate_id, coverage FROM results;

query IR
SELECT k, top_k_accuracy FROM eval_ranking('scored_only', 'gold', k := [1], score_col := 'coverage');
----
1	0.0

# the default k list is 1, 5, 10, 20
query I
SELECT list(k ORDER BY k) FROM eval_ranking('results', 'gold');
----
[1, 5, 10, 20]

statement error
SELECT * FROM eval_ranking('results', 'gold', k := [0]);
----
k must be positive

statement error
SELECT * FROM eval_ranking('results; DROP TABLE gold', 'gold');
----
Invalid identifier

# ---------------------------------------------------------------- eval_calibration

# predicted vs true: (0.9, 1.0), (0.5, 0.4), (0.2, 0.2), (0.8, 0.6): errors -0.1, 0.1, 0, 0.2
#   MAE 0.1, bias +0.05, Pearson 0.92582, Spearman 1 (same order)
statement ok
CREATE TABLE cal AS SELECT * FROM (VALUES
    ('a', 'x', 0.9::DOUBLE), ('b', 'x', 0.5), ('c', 'x', 0.2), ('d', 'x', 0.8)) t(query_id, candidate_id, coverage);

statement ok
CREATE TABLE cal_gold AS SELECT * FROM (VALUES
    ('a', 'x', 1.0::DOUBLE), ('b', 'x', 0.4), ('c', 'x', 0.2), ('d', 'x', 0.6)) t(query_id, candidate_id, true_coverage);

query IRRRR
SELECT n_pairs, round(mae, 6), round(bias, 6), round(pearson, 5), round(spearman, 6) FROM eval_calibration('cal', 'cal_gold');
----
4	0.1	0.05	0.92582	1.0

# ---------------------------------------------------------------- threshold_at_precision

# top-1 picks (predicted, true): q1 0.95/0.95, q2 0.92/0.85, q3 0.91/0.93, q4 0.80/0.95, q5 0.70/0.5
# a pick is good when true >= 0.9. Precision by threshold: 0.95 -> 1.0 (share 0.2), 0.92 -> 0.5,
# 0.91 -> 0.667, 0.80 -> 0.75 (share 0.8), 0.70 -> 0.6
statement ok
CREATE TABLE picks AS SELECT * FROM (VALUES
    ('q1', 'p', 1, 0.95::DOUBLE), ('q2', 'p', 1, 0.92), ('q3', 'p', 1, 0.91), ('q4', 'p', 1, 0.80), ('q5', 'p', 1, 0.70),
    ('q1', 'z', 2, 0.10)) t(query_id, candidate_id, rank, coverage);

statement ok
CREATE TABLE picks_gold AS SELECT * FROM (VALUES
    ('q1', 'p', 0.95::DOUBLE), ('q2', 'p', 0.85), ('q3', 'p', 0.93), ('q4', 'p', 0.95), ('q5', 'p', 0.5), ('q1', 'z', 0.1))
    t(query_id, candidate_id, true_coverage);

# the lowest threshold that keeps the target precision (the largest auto-accept share)
query RRRI
SELECT threshold, precision, accepted_share, n_queries FROM threshold_at_precision('picks', 'picks_gold', target := 0.75);
----
0.8	0.75	0.8	5

query RRR
SELECT threshold, precision, accepted_share FROM threshold_at_precision('picks', 'picks_gold', target := 0.95);
----
0.95	1.0	0.2

query I
SELECT len(curve) FROM threshold_at_precision('picks', 'picks_gold', target := 0.95);
----
5

# unreachable target: no threshold
query I
SELECT threshold IS NULL FROM threshold_at_precision('picks', 'picks_gold', target := 1.0, good := 0.99);
----
true

# ---------------------------------------------------------------- bootstrap_ci

# a constant metric has a zero-width interval; two clusters 0 and 1 give an estimate of 0.5
statement ok
CREATE TABLE per_query AS SELECT * FROM (VALUES
    ('m1', 'q1', 1.0::DOUBLE, 0.0::DOUBLE), ('m1', 'q2', 1.0, 0.0), ('m2', 'q3', 1.0, 1.0), ('m2', 'q4', 1.0, 1.0))
    t(maker, query_id, constant, hit);

query TRRRII
SELECT metric, estimate, lo, hi, n_boot, n_clusters FROM bootstrap_ci('per_query', 'maker', metrics := ['constant'], n := 200);
----
constant	1.0	1.0	1.0	200	2

query TRT
SELECT metric, estimate, lo >= 0 AND hi <= 1 AND lo <= estimate AND estimate <= hi FROM bootstrap_ci('per_query', 'maker', metrics := ['hit'], n := 200);
----
hit	0.5	true

# the same seed gives the same interval; all numeric columns but the cluster by default
query I
SELECT (SELECT list(lo ORDER BY metric) FROM bootstrap_ci('per_query', 'maker', metrics := ['constant', 'hit'], n := 300, seed := 3))
     = (SELECT list(lo ORDER BY metric) FROM bootstrap_ci('per_query', 'maker', metrics := ['constant', 'hit'], n := 300, seed := 3));
----
true

statement error
SELECT * FROM bootstrap_ci('per_query', 'maker', metrics := ['nope']);
----
nope

# ---------------------------------------------------------------- fit_coverage_weights

# reviewed matches: Q1 against the mini programmes with the coverages a reviewer confirmed
# (equal to the kernel at label_weight 0, mu 0, see tree_coverage.test); the grid finds them
statement ok
CREATE TABLE tree_nodes AS SELECT * FROM read_csv_auto('test/data/coverage/mini/tree_nodes.csv');

statement ok
CREATE TABLE tree_attributes AS SELECT * FROM read_csv_auto('test/data/coverage/mini/tree_attributes.csv');

statement ok
CREATE TABLE reviewed_matches AS SELECT * FROM (VALUES
    ('Q1', 'S1', 1.0::DOUBLE), ('Q1', 'S6', 1.0), ('Q1', 'S3', 0.625), ('Q1', 'S2', 0.5), ('Q1', 'S4', 0.125), ('Q1', 'S5', 0.0))
    t(query_id, candidate_id, true_coverage);

query RRRII
SELECT label_weight, mu, round(mae, 6), n_pairs, rank FROM fit_coverage_weights('reviewed_matches',
       label_weights := [0.0, 0.3], mus := [0.0, 0.2]) ORDER BY rank LIMIT 1;
----
0.0	0.0	0.0	6	1

query I
SELECT count(*) FROM fit_coverage_weights('reviewed_matches', label_weights := [0.0, 0.3], mus := [0.0, 0.2]);
----
4

statement error
SELECT * FROM fit_coverage_weights('reviewed_matches', label_weights := [1.5]);
----
label_weights must be between 0 and 1
