# name: test/sql/coverage/r5/uc_03_merge_duplicate_customer_plants.test
# description: The customer master holds planted duplicates (spelling, ü/ue, GmbH/G.m.b.H., moved
#              plants, shared tax ids) and near misses (another company at the same address).
#              The team scores candidate pairs, clusters those above 0.85 and checks that the
#              duplicates are merged and the near misses are not (HLD §4.9).
# group: [coverage]

require anofox_similarity

statement ok
CREATE TABLE customers AS SELECT * FROM read_csv_auto('test/data/coverage/customers.csv.gz');

# normalised identity per record type: umlauts, legal forms, the plant word
statement ok
CREATE MACRO norm(s) AS regexp_replace(replace(replace(replace(replace(replace(lower(COALESCE(s, '')), 'ä', 'ae'), 'ö', 'oe'),
       'ü', 'ue'), 'ß', 'ss'), 'strasse', 'str'), '[^a-z0-9]+', ' ', 'g');

statement ok
CREATE MACRO legal(s) AS CASE WHEN norm(s) LIKE '%g m b h%' OR norm(s) LIKE '%gmbh%'
                              THEN (CASE WHEN norm(s) LIKE '%kg%' THEN 'gmbh co kg' ELSE 'gmbh' END) ELSE norm(s) END;

statement ok
CREATE TABLE records AS
SELECT record_id, record_type, COALESCE(tax_id, '') AS tax, lower(COALESCE(email, '')) AS email,
       COALESCE(parent_record_id, '') AS parent, regexp_extract(COALESCE(plant_name, ''), '([0-9]+)$', 1) AS plant_no,
       trim(norm(CASE record_type WHEN 'contact' THEN contact_name
                                  WHEN 'plant' THEN company_name || ' ' || regexp_replace(norm(plant_name), '^(werk|standort) ', '')
                                  WHEN 'legal_entity' THEN company_name || ' ' || legal(legal_form)
                                  ELSE group_name END)) AS ident,
       norm(street) || ' ' || COALESCE(CAST(house_no AS VARCHAR), '') || ' ' || norm(city) AS addr, norm(city) AS city
FROM customers;

# candidate pairs: same record type, blocked by tax id or city; the score weighs the identity,
# the tax id and the address (contacts: the name, the e-mail and the plant)
statement ok
CREATE TABLE pairs AS
SELECT a.record_id AS a, b.record_id AS b,
       CASE WHEN a.record_type = 'contact'
            THEN 0.5 * jaro_winkler_similarity(a.ident, b.ident) + 0.3 * (a.email = b.email AND a.email <> '')::INT
                 + 0.2 * (a.parent = b.parent AND a.parent <> '')::INT
            WHEN a.record_type = 'plant' AND a.plant_no <> b.plant_no THEN 0.0
            ELSE 0.6 * jaro_winkler_similarity(a.ident, b.ident) + 0.3 * (a.tax <> '' AND a.tax = b.tax)::INT
                 + 0.1 * (a.addr = b.addr)::INT END AS score
FROM records a JOIN records b ON a.record_type = b.record_type AND a.record_id < b.record_id
     AND ((a.tax = b.tax AND a.tax <> '') OR a.city = b.city);

statement ok
CREATE TABLE clusters AS SELECT * FROM cluster_matches('pairs', threshold := 0.85);

# ground truth, for checking only
statement ok
CREATE TABLE gold_clusters AS SELECT * FROM read_csv_auto('test/data/coverage/gold_customer_clusters.csv.gz');

# every planted duplicate ends up in the cluster of its original
query II
SELECT count(*), count(*) FILTER (WHERE c.cluster_id = o.cluster_id)
FROM gold_clusters g JOIN clusters c ON c.entity_id = g.record_id JOIN clusters o ON o.entity_id = g.cluster_id
WHERE g.record_id <> g.cluster_id;
----
152	152

# no near miss is merged with the record it resembles
query II
SELECT count(*), count(*) FILTER (WHERE c.cluster_id = o.cluster_id)
FROM gold_clusters g JOIN clusters c ON c.entity_id = g.record_id JOIN clusters o ON o.entity_id = g.lookalike_of
WHERE g.dup_kind = 'near_miss';
----
12	0

# few false merges: records whose cluster mixes gold clusters
query I
SELECT count(*) <= 20 FROM (
    SELECT c.cluster_id FROM clusters c JOIN gold_clusters g ON g.record_id = c.entity_id
    GROUP BY c.cluster_id HAVING count(DISTINCT g.cluster_id) > 1);
----
true
