# name: test/sql/extension/function_documentation.test
# description: Every function anofox_similarity registers is present and documents itself
# group: [extension]

# tier: tier1

require anofox_similarity

statement ok
LOAD anofox_similarity

# ============================================================================
# The complete registered surface
#
# This test used to assert "10 of 10 documented" against a hardcoded list of
# TEN names while the extension registered 37 -- so it reported green at 10/37
# real coverage. A partial allow-list passes for exactly the functions someone
# remembered to add to it, which is the opposite of what a coverage test does.
#
# The list below is COMPLETE, and the assertions that follow check every entry
# in it. Adding a function means updating this list, which is the point: the
# author has to state the new surface, and the coverage assertions then apply
# to it automatically.
#
# The enumerating check that needs no list at all -- diffing duckdb_functions()
# across the LOAD -- lives in datazoo-banner/audit-function-docs.sh, which a
# sqllogictest cannot do because `require` has already loaded the extension by
# the time the first query runs.
# ============================================================================

statement ok
CREATE TEMP VIEW ours AS
SELECT * FROM duckdb_functions() WHERE function_name IN (
  'aggregate_material_components','bom_common_components','bom_dfs_neighborhood',
  'bom_explosion_1level','bom_explosion_multilevel','bom_to_items','bom_where_used',
  'check_anofox_forecast_available','check_duckpgq_available','check_statistics_freshness',
  'cold_start_analogs','compute_domain_specific_statistics','compute_fused_embeddings',
  'compute_jaccard_embeddings','compute_textual_embeddings','compute_transactional_embeddings',
  'create_bom_property_graph','dynamics365_to_bom_component','dynamics365_to_bom_header',
  'dynamics365_to_materials','embed_text','embedding_backend','extract_material_descriptions',
  'extract_ts_features','filter_recent_movements','find_similar_materials_jaccard',
  'find_similar_materials_wl_kernel','fuse_embeddings','infer_predecessors','items_to_bom',
  'jaccard_similarity','recompute_embedding_statistics','sap_to_bom_items','sap_to_materials',
  'sap_to_materials_with_desc','wl_fingerprint','wl_kernel_similarity',
  -- coverage matching (R1)
  'containment','find_covering_entities','find_covering_entities_for','tversky_similarity',
  'weighted_containment','weighted_jaccard','weighted_tversky',
  -- coverage matching (R2)
  'compat_score','normalize_quantity','parse_quantity','quantity_units','value_satisfies',
  -- coverage matching (R3)
  'tree_anchors','tree_class_multiset','tree_from_json','tree_multiset','validate_trees',
  'coverage_kernel','coverage_recall','tree_coverage','tree_coverage_trace',
  'maxsim','bhattacharyya','calibrated_cosine','cosine_floor','classify_to_catalogue',
  'vocabulary_review_queue','apply_vocabulary_review','uncertain_decisions');

# Every name above resolves. A dropped registration is the SILENT failure mode
# of the DefaultMacro conversion: the macro struct stays defined, the file still
# compiles, and the function simply is not there any more. That happened once
# during the conversion -- rewriting RegisterBOMTraversalMacros dropped the
# bom_explosion_1level call while its struct stayed put -- and only a count
# caught it.
query I
SELECT count(DISTINCT function_name) FROM ours;
----
66

# ============================================================================
# ...and every one of them is documented
# ============================================================================

query I
SELECT count(*) FROM ours
WHERE description IS NULL OR description = ''
   OR len(examples) = 0
   OR len(categories) = 0
   -- ANY colN, not just col0: DuckDB pads parameter_names positionally, so a list
   -- covering only the first arguments renders as (a, b, col2, col3) -- named at the
   -- front, placeholders at the back. Checking col0 alone passes exactly that case.
   OR list_has_any(parameters, ['col0','col1','col2','col3','col4','col5','col6','col7','col8','col9']);
----
0

# ============================================================================
# Macros are registered internally, not written into the user's database
#
# They used to be created by EXECUTING "CREATE OR REPLACE MACRO ..." against a
# connection, which persisted extension-owned definitions into whatever database
# file the user had open, where they would go stale against a future version of
# the extension. Registering them through the loader puts them in the system
# catalog instead -- which is also why they now work on a read-only database,
# where the whole conn-based block is skipped.
# ============================================================================

query I
SELECT count(*) = 0 FROM ours
WHERE function_type IN ('macro', 'table_macro') AND NOT internal;
----
true

query I
SELECT count(*) FROM ours WHERE function_type = 'table_macro';
----
23

query I
SELECT count(DISTINCT function_name) FROM ours WHERE function_type = 'macro';
----
5

# ============================================================================
# Parameter names survive
#
# A macro already reports its real parameter names, so documenting one must not
# set parameter_names -- a non-empty parameter_names replaces the WHOLE rendered
# list and would overwrite these with col1, col2, ...
# ============================================================================

query I
SELECT parameters FROM ours WHERE function_name = 'bom_explosion_1level';
----
[query_material_id, header_table, component_table]

query I
SELECT parameters FROM ours WHERE function_name = 'sap_to_bom_items';
----
[mast_table, stko_table, stpo_table, bom_alternative, reference_date, bom_usage]

query I
SELECT parameters FROM ours WHERE function_name = 'wl_kernel_similarity';
----
[material_a, material_b, iterations, bom_table]

# ============================================================================
# The C++ table functions name their named parameters too
#
# These four had parameter_names covering only their POSITIONAL arguments, so
# duckdb_functions() padded the rest: (material_id, k, col2, col3, col4). That
# is documented at the front and placeholders at the back, and it slipped past
# the first version of the doc audit because that only looked for `col0` --
# which these do not have, since the first argument IS named.
#
# The named parameters come out in case_insensitive_map_t order, which is
# neither sorted nor guaranteed stable. Pinning the rendered list is what makes
# the order in the source trustworthy rather than a guess that happened to work.
# ============================================================================

query I
SELECT parameters FROM ours WHERE function_name = 'find_similar_materials_jaccard';
----
[material_id, k, bom_table, min_similarity, mode]

query I
SELECT parameters FROM ours WHERE function_name = 'find_covering_entities';
----
[query_entity_id, k, mode, alpha, beta, weighted, tie_break, min_score, feature_table, entity_col, feature_col, weight_col]

query I
SELECT parameters FROM ours WHERE function_name = 'find_covering_entities_for';
----
[query, k, mode, alpha, beta, weighted, tie_break, min_score, feature_table, entity_col, feature_col, weight_col]

query I
SELECT list(parameters ORDER BY len(parameters)) FROM ours WHERE function_name = 'weighted_tversky';
----
[[query, candidate], [query, candidate, alpha, beta]]

query I
SELECT parameters FROM ours WHERE function_name = 'find_similar_materials_wl_kernel';
----
[material_id, k, bom_table, min_similarity, iterations]

query I
SELECT parameters FROM ours WHERE function_name = 'cold_start_analogs';
----
[material_id, k, movements_table, bom_table, min_similarity, min_history_months]

query I
SELECT parameters FROM ours WHERE function_name = 'infer_predecessors';
----
[material_id, movements_table, bom_table, min_overlapping_weeks, lag_weeks, min_confidence, min_similarity, lookback_months]

query I
SELECT parameters FROM ours WHERE function_name = 'compute_transactional_embeddings';
----
[movements_table, time_window_days, batch_size, batch_offset]

query I
SELECT parameters FROM ours WHERE function_name = 'compute_jaccard_embeddings';
----
[bom_table]

query I
SELECT parameters FROM ours WHERE function_name = 'compat_score';
----
[dimension, required, provided, rules_table]

query I
SELECT list(parameters ORDER BY len(parameters)) FROM ours WHERE function_name = 'value_satisfies';
----
[[requirement, provided], [requirement, provided, scale], [requirement, provided, scale, tol, soft_band], [requirement, provided, scale, tol, soft_band, default_bound]]

query I
SELECT list(parameters ORDER BY len(parameters), parameters[2]) FROM ours WHERE function_name = 'tree_anchors';
----
[[nodes_table, attrs_table, overrides_table, label_table, tree_ids], [nodes_table, attrs_table, overrides_table, label_table, tree_ids]]

query I
SELECT list(parameters ORDER BY len(parameters)) FROM ours WHERE function_name = 'tree_from_json';
----
[[json], [json, tree_id], [json, tree_id, lang], [json, tree_id, lang, unit_table]]

query I
SELECT parameters FROM ours WHERE function_name = 'coverage_recall';
----
[query_tree_id, candidates, k, nodes_table, candidate_nodes_table, overrides_table, label_table, mode, tie_break, candidate_multiset_table]

query I
SELECT parameters FROM ours WHERE function_name = 'classify_to_catalogue';
----
[items_table, catalogue_table, mode, center_by_source, attr_bonus, temperature, overrides_table, answers_table, attrs_table, templates_table, name_vectors, name_floor, top]
