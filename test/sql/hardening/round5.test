# name: test/sql/hardening/round5.test
# description: Round-5 exploratory findings: usage from consumption, cold-start density, unit slips
# group: [hardening]

require anofox_similarity

# ---------------------------------------------------------------- usage is consumption (planner F7)

statement ok
CREATE TABLE bom_items (parent_id VARCHAR, child_id VARCHAR);

statement ok
INSERT INTO bom_items VALUES
  ('OLD', 'SEAL'), ('OLD', 'SHAFT'), ('OLD', 'MOTOR'),
  ('NEW', 'SEAL'), ('NEW', 'SHAFT'), ('NEW', 'MOTOR'),
  ('A-SPARSE', 'SEAL'), ('A-SPARSE', 'SHAFT'), ('A-SPARSE', 'PUMP-HEAD'),
  ('B-DENSE', 'SEAL'), ('B-DENSE', 'SHAFT'), ('B-DENSE', 'PUMP-HEAD'),
  ('NEXT', 'SEAL'), ('NEXT', 'SHAFT'), ('NEXT', 'PUMP-HEAD');

# OLD runs down over 30 weeks, NEW ramps up from week 20; one late return of OLD in week 60
statement ok
CREATE TABLE goods_movements AS
SELECT 'OLD' AS material_id, DATE '2024-01-01' + 7 * w::INTEGER AS movement_date, 300.0 - 10 * w AS quantity
FROM range(0, 30) t(w)
UNION ALL
SELECT 'NEW', DATE '2024-01-01' + 7 * w::INTEGER, 10.0 * w - 150 FROM range(20, 50) t(w)
UNION ALL
SELECT 'OLD', DATE '2024-01-01' + 7 * 60, -3.0;

statement ok
CREATE VIEW no_return AS SELECT * FROM goods_movements WHERE quantity > 0 OR material_id <> 'OLD';

# the late return changes nothing: same result as without it
query TRRTI
SELECT predecessor_id, confidence, temporal_score, predecessor_last_usage, overlapping_weeks
FROM infer_predecessors('NEW')
EXCEPT
SELECT predecessor_id, confidence, temporal_score, predecessor_last_usage, overlapping_weeks
FROM infer_predecessors('NEW', movements_table := 'no_return');
----

query TT
SELECT predecessor_id, predecessor_last_usage FROM infer_predecessors('NEW');
----
OLD	2024-07-22

# cold start: the return does not extend OLD's history
query TT
SELECT material_id, last_usage FROM cold_start_analogs('NEXT', 5, min_similarity := 0.2) WHERE material_id = 'OLD';
----
OLD	2024-07-22

# a material with returns only has no history and is no analog
statement ok
CREATE TABLE returns_only AS SELECT * FROM goods_movements
UNION ALL SELECT 'A-SPARSE', DATE '2024-01-01' + 7 * w::INTEGER, -2.0 FROM range(0, 40) t(w);

query I
SELECT count(*) FROM cold_start_analogs('NEXT', 5, min_similarity := 0.2, movements_table := 'returns_only')
WHERE material_id = 'A-SPARSE';
----
0

# ---------------------------------------------------------------- density breaks ties (planner F12)

# A-SPARSE and B-DENSE have the same BOM similarity to NEXT and the same span; by id A-SPARSE would come first
statement ok
CREATE TABLE density AS SELECT * FROM goods_movements
UNION ALL SELECT 'A-SPARSE', DATE '2024-01-01', 5.0
UNION ALL SELECT 'A-SPARSE', DATE '2025-06-02', 5.0
UNION ALL SELECT 'B-DENSE', DATE '2024-01-01' + 7 * w::INTEGER, 20.0 FROM range(0, 75) t(w);

query TRII
SELECT material_id, similarity, history_months, movement_weeks
FROM cold_start_analogs('NEXT', 2, movements_table := 'density');
----
B-DENSE	1.0	17	75
A-SPARSE	1.0	17	2

# ---------------------------------------------------------------- unit slips and fixes in the details (new user F5, F9)

statement ok
CREATE TABLE n AS SELECT * FROM (VALUES
  ('R', 'R', NULL, 'container', 'AND', 'request', NULL, 1.0), ('R', 'R.1', 'R', 'item', 'AND', 'motor', 'motor', 1.0),
  ('A', 'A', NULL, 'container', 'AND', 'offer a', NULL, 1.0), ('A', 'A.1', 'A', 'item', 'AND', 'motor', 'motor', 1.0),
  ('B', 'B', NULL, 'container', 'AND', 'offer b', NULL, 1.0), ('B', 'B.1', 'B', 'item', 'AND', 'motor', 'motor', 1.0)
) t(tree_id, node_id, parent_id, node_kind, edge_type, label, class_id, count);

statement ok
CREATE TABLE attrs AS SELECT * FROM (VALUES
  ('R', 'R.1', 'p', 'Nennleistung', 'power', 'W', 750.0, 750.0, NULL, 'rated_power'),
  ('A', 'A.1', 'p', 'rated power', 'power', 'W', 0.55, 0.55, NULL, 'rated_power'),
  ('B', 'B.1', 'p', 'rated power', 'power', 'W', 700.0, 700.0, NULL, 'rated_power'),
  ('B', 'B.1', 'ip', 'protection', NULL, NULL, NULL, NULL, 'IP65', NULL),
  ('A', 'A.1', 't', 'response', NULL, 'msec', 5.0, 5.0, NULL, NULL)
) t(tree_id, node_id, attr_id, name, dimension, unit, lo, hi, category, attr_key);

query TTT
SELECT tree_id, attr_id, issue FROM validate_trees('n', 'attrs') ORDER BY ALL;
----
A	p	magnitude_outlier
A	t	unknown_unit
B	ip	category_without_dimension

query I
SELECT count(*) FROM validate_trees('n', 'attrs')
WHERE (issue = 'magnitude_outlier' AND tree_id = 'A' AND detail LIKE '%1/1318 of the median (725.0) of 2 of its 2 other values%unit slip%')
   OR (issue = 'unknown_unit' AND detail LIKE '%unit msec%unit_table%')
   OR (issue = 'category_without_dimension' AND detail LIKE '%give the attribute an attr_key%');
----
3

# two values of one key: each is compared with the other
query I
SELECT count(*) FROM validate_trees('n', 'attrs', tree_ids := ['R', 'A']) WHERE issue = 'magnitude_outlier';
----
2

# values within a factor of 300 are not flagged
statement ok
UPDATE attrs SET lo = 7.5, hi = 7.5 WHERE tree_id = 'A' AND attr_id = 'p';

query I
SELECT count(*) FROM validate_trees('n', 'attrs') WHERE issue = 'magnitude_outlier';
----
0

# aas_issues reports a unit text it does not know (validate_trees warns too)
query TT
SELECT i.issue, i.severity FROM (SELECT unnest(aas_issues('{"submodels": [{"modelType": "Submodel", "id": "urn:t:sm", "idShort": "TechnicalData", "submodelElements": [
  {"modelType": "SubmodelElementCollection", "idShort": "Drive", "value": [
    {"modelType": "Property", "idShort": "ResponseTime", "valueType": "xs:double", "value": "5",
     "semanticId": {"type": "ExternalReference", "keys": [{"type": "GlobalReference", "value": "0173-1#02-AAA001#001"}]},
     "embeddedDataSpecifications": [{"dataSpecificationContent": {"modelType": "DataSpecificationIec61360", "unit": "msec"}}]}]}]}]}', 'T')) AS i)
WHERE i.issue = 'unknown_unit';
----
unknown_unit	warning

# ---------------------------------------------------------------- names choose, without discount
# Without name vectors the names still choose which value answers (token overlap), but do not
# lower the score: both offered lengths meet 'at least 60 mm', the one named like the
# requirement answers it, and the coverage is 1.

statement ok
CREATE TABLE np_docs AS SELECT * FROM (VALUES
  ('{"tree_id": "NQ", "root": {"node_id": "NQ", "children": [{"node_id": "NQ.1", "label": "headrest", "class_id": "headrest",
     "attributes": [{"attr_id": "h", "name": "height travel", "text": "at least 60 mm"}]}]}}'),
  ('{"tree_id": "NO", "root": {"node_id": "NO", "children": [{"node_id": "NO.1", "label": "headrest", "class_id": "headrest",
     "attributes": [{"attr_id": "a", "name": "width", "text": "70 mm"}, {"attr_id": "z", "name": "height travel", "text": "65 mm"}]}]}}')
) t(doc);

statement ok
CREATE TABLE np_n AS SELECT unnest(tree_from_json(doc)) AS x FROM np_docs;

statement ok
CREATE TABLE np_nodes AS SELECT x.* EXCLUDE (attributes) FROM np_n;

statement ok
CREATE TABLE np_attrs AS SELECT unnest(x.attributes, recursive := true) FROM np_n;

query TRRT
SELECT prov_value, attr_score, (SELECT coverage FROM tree_coverage('NQ', candidates := ['NO'], nodes_table := 'np_nodes', attrs_table := 'np_attrs')), name_rule
FROM tree_coverage_trace('NQ', candidates := ['NO'], nodes_table := 'np_nodes', attrs_table := 'np_attrs');
----
0.065 m	1.0	1.0	exact

# ---------------------------------------------------------------- final review F8: promised behaviour

# mu still discounts with name vectors: cos 0.96, floor 0.85 -> name_sim 0.7333;
# attr = (0.2 * 0.7333 + 0.8) * 1 = 0.9467, and 1.0 with mu := 0
statement ok
CREATE TABLE nvd AS SELECT * FROM (VALUES
 ('{"tree_id": "VQ", "root": {"node_id": "VQ", "children": [{"node_id": "VQ.1", "label": "heater", "class_id": "heating", "attributes": [{"attr_id": "p", "name": "Heizleistung", "text": "mind. 60 W"}]}]}}'),
 ('{"tree_id": "VO", "root": {"node_id": "VO", "children": [{"node_id": "VO.1", "label": "heater", "class_id": "heating", "attributes": [{"attr_id": "q", "name": "heating power", "text": "80 W"}]}]}}')) t(doc);

statement ok
CREATE TABLE nvn AS SELECT unnest(tree_from_json(doc)) AS x FROM nvd;

statement ok
CREATE TABLE nv_nodes AS SELECT x.* EXCLUDE (attributes) FROM nvn;

statement ok
CREATE TABLE nv_attrs AS SELECT unnest(x.attributes, recursive := true) FROM nvn;

statement ok
CREATE TABLE nv_vec AS SELECT * FROM (VALUES ('Heizleistung', [1.0, 0.0]::FLOAT[2]), ('heating power', [0.96, 0.28]::FLOAT[2])) t(name, vec);

query RRT
SELECT (SELECT round(coverage, 4) FROM tree_coverage('VQ', candidates := ['VO'], nodes_table := 'nv_nodes', attrs_table := 'nv_attrs', name_vectors := 'nv_vec')),
       (SELECT round(coverage, 4) FROM tree_coverage('VQ', candidates := ['VO'], nodes_table := 'nv_nodes', attrs_table := 'nv_attrs', name_vectors := 'nv_vec', mu := 0.0)),
       (SELECT name_rule FROM tree_coverage_trace('VQ', candidates := ['VO'], nodes_table := 'nv_nodes', attrs_table := 'nv_attrs', name_vectors := 'nv_vec'));
----
0.9467	1.0	vector

# aas_quality counts an unknown unit text (msec) as an issue and an unresolved unit
query III
SELECT q.n_values, q.n_unresolved_units, q.n_issues FROM (SELECT unnest(aas_quality('{"submodels": [{"modelType": "Submodel", "id": "urn:x:sm", "idShort": "TechnicalData", "submodelElements": [{"modelType": "Property", "idShort": "CycleTime", "valueType": "xs:double", "value": "1", "semanticId": {"type": "ExternalReference", "keys": [{"type": "GlobalReference", "value": "0173-1#02-AAQ326#004"}]}, "embeddedDataSpecifications": [{"dataSpecificationContent": {"modelType": "DataSpecificationIec61360", "unit": "msec"}}]}]}]}')) AS q);
----
1	1	1

# without name vectors every mu gives the same coverage, so fit_coverage_weights finds equal MAE
statement ok
CREATE TABLE fit_nodes AS SELECT * FROM read_csv('test/data/coverage/mini/tree_nodes.csv');

statement ok
CREATE TABLE fit_attrs AS SELECT * FROM read_csv('test/data/coverage/mini/tree_attributes.csv');

statement ok
CREATE TABLE fit_rm AS SELECT * FROM (VALUES ('Q1','S1',1.0),('Q1','S2',0.5),('Q1','S3',0.6),('Q1','S6',1.0)) t(query_id, candidate_id, true_coverage);

query II
SELECT count(*), count(DISTINCT mae) FROM fit_coverage_weights('fit_rm', label_weights := [0.0], mus := [0.0, 0.2, 0.5],
  nodes_table := 'fit_nodes', attrs_table := 'fit_attrs');
----
3	1

# ---------------------------------------------------------------- final review F4, F9: magnitude_outlier

statement ok
CREATE TABLE mo_nodes AS SELECT * FROM (VALUES ('T1','T1',NULL,'container','AND','x',NULL,1.0),('T1','T1.1','T1','item','AND','x','c',1.0),
  ('T2','T2',NULL,'container','AND','x',NULL,1.0),('T2','T2.1','T2','item','AND','x','c',1.0),
  ('T3','T3',NULL,'container','AND','x',NULL,1.0),('T3','T3.1','T3','item','AND','x','c',1.0)) t(tree_id,node_id,parent_id,node_kind,edge_type,label,class_id,count);

# currencies never convert: 150 EUR against 150000 JPY is not a unit slip
statement ok
CREATE TABLE mo_cur AS SELECT * FROM (VALUES ('T1','T1.1','a','price','currency','EUR',150.0,150.0),('T2','T2.1','a','price','currency','JPY',150000.0,150000.0)) t(tree_id,node_id,attr_id,name,dimension,unit,lo,hi);

query I
SELECT count(*) FROM validate_trees('mo_nodes', 'mo_cur') WHERE issue = 'magnitude_outlier';
----
0

# compared with the other values, never with itself: of 0.55, 0.6 and 750 W only 750 W is off from
# more than half of the others
statement ok
CREATE TABLE mo_pw AS SELECT * FROM (VALUES ('T1','T1.1','a','power','power','W',0.55,0.55),('T2','T2.1','a','power','power','W',0.6,0.6),('T3','T3.1','a','power','power','W',750.0,750.0)) t(tree_id,node_id,attr_id,name,dimension,unit,lo,hi);

query TT
SELECT tree_id, detail FROM validate_trees('mo_nodes', 'mo_pw') WHERE issue = 'magnitude_outlier';
----
T3	value 750.0 W is about 1304 x the median (0.575) of 2 of its 2 other values of power [power]: a unit slip (W for kW, mm for m)?
