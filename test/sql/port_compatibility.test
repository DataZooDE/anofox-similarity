# name: test/sql/port_compatibility.test
# description: Value-sensitive named parameter compatibility across DuckDB lines
# group: [extension]
require anofox_similarity

statement ok
CREATE TABLE bom_items(parent_id VARCHAR, child_id VARCHAR);

statement ok
INSERT INTO bom_items VALUES
 ('A','X'), ('A','Y'), ('B','X'), ('X','Z'),
 ('S','K1'), ('S','K2'), ('P','K1'), ('P','K2');

statement ok
CREATE TABLE alt_bom(parent_id VARCHAR, child_id VARCHAR);

statement ok
INSERT INTO alt_bom VALUES ('A','ONLY');

statement ok
CREATE TABLE goods_movements(material_id VARCHAR, movement_date DATE, quantity DOUBLE);

statement ok
INSERT INTO goods_movements VALUES
 ('A', DATE '2024-01-01', 1),
 ('B', DATE '2024-01-01', 1), ('B', DATE '2024-03-01', 1),
 ('S', DATE '2024-01-08', 1), ('S', DATE '2024-01-15', 2), ('S', DATE '2024-01-22', 3),
 ('P', DATE '2024-01-01', 3), ('P', DATE '2024-01-08', 2), ('P', DATE '2024-01-15', 1);

statement ok
CREATE TABLE alt_moves(material_id VARCHAR, movement_date DATE, quantity DOUBLE);

statement ok
INSERT INTO alt_moves VALUES ('A', DATE '2024-01-01', 1), ('A', DATE '2024-01-03', 2);

query I
SELECT count(*) FROM find_similar_materials_jaccard('A', 5);
----
4

query I
SELECT count(*) FROM find_similar_materials_jaccard('A', 5, min_similarity := 0.99);
----
0

query I
SELECT count(*) FROM find_similar_materials_jaccard('A', 5, bom_table := 'alt_bom');
----
0

statement error
SELECT * FROM find_similar_materials_jaccard('A', 5, bom_table := 'nope');
----
nope

query I
SELECT count(*) FROM find_similar_materials_wl_kernel('A', 5, min_similarity := 0.6, iterations := 1);
----
0

query I
SELECT count(*) FROM find_similar_materials_wl_kernel('A', 5, min_similarity := 0.6, iterations := 2);
----
1

query I
SELECT count(*) FROM find_similar_materials_wl_kernel('A', 5, bom_table := 'alt_bom');
----
0

