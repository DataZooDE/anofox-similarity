# name: test/sql/schema/bom_conversion.test
# description: Test conversion between flat bom_items and universal schema
# group: [schema]

# tier: tier1

require anofox_similarity

statement ok
PRAGMA enable_verification

# ============================================================================
# Test 1: Create legacy flat bom_items table
# ============================================================================

statement ok
CREATE TABLE legacy_bom_items AS
SELECT * FROM (VALUES
    ('PROD-A', 'COMP-1', 2.0),
    ('PROD-A', 'COMP-2', 1.5),
    ('PROD-B', 'COMP-1', 3.0)
) AS t(parent_id, child_id, quantity)

# ============================================================================
# Test 2: items_to_materials, items_to_bom_header, items_to_bom_component
# ============================================================================

query I
SELECT COUNT(*) FROM items_to_materials('legacy_bom_items', 'LEGACY')
----
4

query I
SELECT COUNT(*) FROM items_to_bom_header('legacy_bom_items', 'LEGACY')
----
2

query I
SELECT COUNT(*) FROM items_to_bom_component('legacy_bom_items')
----
3

# Every header row carries the source system in its own column (it used to shift columns).
query TT
SELECT DISTINCT source_system, typeof(valid_from) FROM items_to_bom_header('legacy_bom_items', 'LEGACY')
----
LEGACY	DATE

# ============================================================================
# Test 3: The results insert into the universal schema tables unchanged
# ============================================================================

statement ok
CREATE TABLE test_materials AS SELECT * FROM items_to_materials('legacy_bom_items', 'LEGACY')

statement ok
CREATE TABLE test_bom_header AS SELECT * FROM items_to_bom_header('legacy_bom_items', 'LEGACY')

statement ok
CREATE TABLE test_bom_component AS SELECT * FROM items_to_bom_component('legacy_bom_items')

# ============================================================================
# Test 4: Round trip back to bom_items
# ============================================================================

query TTR
SELECT parent_id, child_id, quantity
FROM bom_to_items(header_table := 'test_bom_header', component_table := 'test_bom_component')
ORDER BY parent_id, child_id
----
PROD-A	COMP-1	2.0
PROD-A	COMP-2	1.5
PROD-B	COMP-1	3.0
