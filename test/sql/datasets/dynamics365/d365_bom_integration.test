# name: test/sql/datasets/dynamics365/d365_bom_integration.test
# description: Dynamics 365 end-to-end BOM integration with similarity search (native D365 columns)
# group: [dynamics365]

# tier: tier2

require anofox_similarity

statement ok
PRAGMA enable_verification

# ============================================================================
# Test 1: D365 master data (InventTable)
# ============================================================================

statement ok
CREATE TABLE d365_materials AS
SELECT * FROM (VALUES
    ('MAT-A', 'Product A', 1),
    ('MAT-B', 'Component B', 0),
    ('MAT-C', 'Component C', 0),
    ('MAT-D', 'Product D', 1)
) AS t(ItemId, ItemName, ItemType)

# ============================================================================
# Test 2: D365 BOM versions (active and approved)
# ============================================================================

statement ok
CREATE TABLE d365_versions AS
SELECT * FROM (VALUES
    ('MAT-A', 'BOM-A', TIMESTAMP '2024-01-01 00:00:00', DATE '1900-01-01', 1, 1),
    ('MAT-D', 'BOM-D', TIMESTAMP '2024-01-01 00:00:00', DATE '1900-01-01', 1, 1)
) AS t(ItemId, BOMId, FromDate, ToDate, Active, Approved)

# ============================================================================
# Test 3: D365 BOM lines
# ============================================================================

statement ok
CREATE TABLE d365_components AS
SELECT * FROM (VALUES
    ('BOM-A', 1, 'MAT-B', 2.0, 1.0, 'pcs', 5.0),
    ('BOM-A', 2, 'MAT-C', 1.5, 1.0, 'kg', 0.0),
    ('BOM-D', 1, 'MAT-B', 1.0, 1.0, 'pcs', 2.0)
) AS t(BOMId, LineNum, ItemId, BOMQty, BOMQtySerie, UnitId, ScrapVar)

# ============================================================================
# Test 4: convert to the universal schema
# ============================================================================

query I
SELECT COUNT(*) FROM dynamics365_to_materials('d365_materials')
----
4

query I
SELECT COUNT(*) FROM dynamics365_to_bom_header(bom_version := 'd365_versions')
WHERE is_approved = TRUE
----
2

query I
SELECT COUNT(*) FROM dynamics365_to_bom_component(bom_lines := 'd365_components', bom_version := 'd365_versions')
WHERE quantity_per > 0 AND scrap_percent >= 0
----
3

# ============================================================================
# Test 5: flatten and search
# ============================================================================

statement ok
CREATE TABLE d365_header AS SELECT * FROM dynamics365_to_bom_header(bom_version := 'd365_versions')

statement ok
CREATE TABLE d365_component AS SELECT * FROM dynamics365_to_bom_component(bom_lines := 'd365_components', bom_version := 'd365_versions')

statement ok
CREATE TABLE bom_items AS SELECT * FROM bom_to_items(header_table := 'd365_header', component_table := 'd365_component')

query TT
SELECT parent_id, child_id FROM bom_items ORDER BY ALL
----
MAT-A	MAT-B
MAT-A	MAT-C
MAT-D	MAT-B

# MAT-A and MAT-D share MAT-B: Jaccard 1/2
query TR
SELECT material_id, similarity FROM find_similar_materials_jaccard('MAT-A', 5)
----
MAT-D	0.5
