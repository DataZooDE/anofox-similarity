# name: test/sql/functions/dynamics365_transformations.test
# description: Dynamics 365 BOM transformations to universal schema (native D365 columns)
# group: [functions]

# tier: tier1

require anofox_similarity

statement ok
PRAGMA enable_verification

# ============================================================================
# Test 1: Dynamics 365 InventTable (materials master); ItemType 0 Item, 1 BOM, 2 Service
# ============================================================================

statement ok
CREATE TABLE d365_InventTable AS
SELECT * FROM (VALUES
    ('ITEM-001', 'Assembly 1', 1),
    ('ITEM-002', 'Component 1', 0),
    ('ITEM-003', 'Component 2', 0)
) AS t(ItemId, ItemName, ItemType)

# ============================================================================
# Test 2: Dynamics 365 BOMVersion (links items to BOMs, with validity and approval)
# ============================================================================

statement ok
CREATE TABLE d365_BOMVersion AS
SELECT * FROM (VALUES
    ('ITEM-001', 'BOM-001', DATE '2024-01-01', DATE '1900-01-01', 1, 1),
    ('ITEM-002', 'BOM-002', DATE '2024-01-15', DATE '1900-01-01', 1, 0)
) AS t(ItemId, BOMId, FromDate, ToDate, Active, Approved)

# ============================================================================
# Test 3: Dynamics 365 BOM lines
# ============================================================================

statement ok
CREATE TABLE d365_BOM AS
SELECT * FROM (VALUES
    ('BOM-001', 1, 'ITEM-002', 2.0, 1.0, 'pcs', 5.0),
    ('BOM-001', 2, 'ITEM-003', 1.5, 1.0, 'kg', 0.0),
    ('BOM-002', 1, 'ITEM-001', 3.0, 1.0, 'pcs', 10.0)
) AS t(BOMId, LineNum, ItemId, BOMQty, BOMQtySerie, UnitId, ScrapVar)

# ============================================================================
# Test 4: counts
# ============================================================================

query I
SELECT COUNT(*) FROM dynamics365_to_materials('d365_InventTable')
----
3

query I
SELECT COUNT(*) FROM dynamics365_to_bom_header(bom_version := 'd365_BOMVersion')
----
2

query I
SELECT COUNT(*) FROM dynamics365_to_bom_component(bom_lines := 'd365_BOM', bom_version := 'd365_BOMVersion')
----
3

# ============================================================================
# Test 5: approval, scrap, units and ids
# ============================================================================

query I
SELECT COUNT(*) FROM dynamics365_to_bom_header(bom_version := 'd365_BOMVersion')
WHERE is_approved = TRUE
----
1

query I
SELECT COUNT(*) FROM dynamics365_to_bom_component(bom_lines := 'd365_BOM', bom_version := 'd365_BOMVersion')
WHERE scrap_percent > 0
----
2

query TT
SELECT child_material_id, quantity_uom FROM dynamics365_to_bom_component(bom_lines := 'd365_BOM', bom_version := 'd365_BOMVersion')
WHERE bom_id = 'ITEM-001/BOM-001' ORDER BY 1
----
ITEM-002	pcs
ITEM-003	kg

query TT
SELECT bom_id, source_bom_id FROM dynamics365_to_bom_header(bom_version := 'd365_BOMVersion') ORDER BY 1
----
ITEM-001/BOM-001	BOM-001
ITEM-002/BOM-002	BOM-002

# ============================================================================
# Test 6: material types follow D365's ItemType enum
# ============================================================================

query TT
SELECT material_id, material_type FROM dynamics365_to_materials('d365_InventTable') ORDER BY 1
----
ITEM-001	BOM
ITEM-002	ITEM
ITEM-003	ITEM

# ============================================================================
# Test 7: source system
# ============================================================================

query I
SELECT COUNT(*) FROM dynamics365_to_materials('d365_InventTable') WHERE source_system = 'DYNAMICS365'
----
3
