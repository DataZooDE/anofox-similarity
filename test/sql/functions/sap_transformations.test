# name: test/sql/functions/sap_transformations.test
# description: Tests for SAP transformation macros (sap_to_materials)
# group: [functions]

# tier: tier1

require anofox_similarity

statement ok
PRAGMA enable_verification

# ============================================================================
# Setup: Create minimal synthetic SAP tables for unit testing
# ============================================================================

# MARA: Material Master
statement ok
CREATE TABLE test_mara AS SELECT * FROM (VALUES
    ('0000001', 'FERT', 'GRP01', '20200115', NULL),
    ('0000002', 'HALB', 'GRP02', '20210301', NULL),
    ('0000003', 'ROH', 'GRP01', '20190520', NULL),
    ('0000004', 'FERT', 'GRP03', '20220101', 'X'),
    ('0000005', 'FERT', 'GRP01', '20230601', NULL)
) AS t(matnr, mtart, matkl, ersda, lvorm);

# MAKT: Material Descriptions
statement ok
CREATE TABLE test_makt AS SELECT * FROM (VALUES
    ('0000001', 'E', 'English Product A'),
    ('0000001', 'D', 'German Product A'),
    ('0000002', 'E', 'Assembly Component'),
    ('0000003', 'E', 'Steel Material'),
    ('0000005', 'E', 'New Product')
) AS t(matnr, spras, maktx);

# ============================================================================
# sap_to_materials_with_desc() Tests
# ============================================================================

# Test 1: sap_to_materials_with_desc returns non-empty result
query I
SELECT COUNT(*) > 0 FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'test_makt',
    language := 'E'
);
----
true

# Test 2: Should have correct output columns
query I
SELECT COUNT(*) FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'test_makt',
    language := 'E'
)
WHERE material_id = '0000001'
  AND material_type = 'FERT'
  AND material_group = 'GRP01'
  AND created_date IS NOT NULL;
----
1

# Test 3: Should have descriptions
query T
SELECT description FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'test_makt',
    language := 'E'
)
WHERE material_id = '0000001';
----
English Product A

# Test 4: Should exclude deleted materials (lvorm = 'X')
query I
SELECT COUNT(*) FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'test_makt',
    language := 'E'
)
WHERE material_id = '0000004';
----
0

# Test 5: Non-deleted materials should be included (4 out of 5)
query I
SELECT COUNT(*) FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'test_makt',
    language := 'E'
)
WHERE material_id IN ('0000001', '0000002', '0000003', '0000005');
----
4

# Test 6: Language filtering works - German descriptions
query T
SELECT description FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'test_makt',
    language := 'D'
)
WHERE material_id = '0000001';
----
German Product A

# Test 7: Material types should match input
query T rowsort
SELECT material_type FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'test_makt',
    language := 'E'
)
WHERE material_type IN ('FERT', 'HALB', 'ROH')
ORDER BY material_type;
----
FERT
FERT
HALB
ROH

# Test 8: created_date should be parsed as DATE from YYYYMMDD format
query I
SELECT COUNT(*) FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'test_makt',
    language := 'E'
)
WHERE material_id = '0000001'
  AND created_date = '2020-01-15'::DATE;
----
1

# Test 9: Non-existent MARA table should produce error
statement error
SELECT COUNT(*) FROM sap_to_materials_with_desc(
    mara_table := 'nonexistent_table',
    makt_table := 'test_makt',
    language := 'E'
);
----
Catalog Error

# Test 10: Non-existent MAKT table should produce error
statement error
SELECT COUNT(*) FROM sap_to_materials_with_desc(
    mara_table := 'test_mara',
    makt_table := 'nonexistent_table',
    language := 'E'
);
----
Catalog Error

# Test 11: Different languages produce different descriptions
query I
SELECT COUNT(DISTINCT description) FROM (
    SELECT description FROM sap_to_materials_with_desc(
        mara_table := 'test_mara',
        makt_table := 'test_makt',
        language := 'E'
    )
    WHERE material_id = '0000001'
    UNION ALL
    SELECT description FROM sap_to_materials_with_desc(
        mara_table := 'test_mara',
        makt_table := 'test_makt',
        language := 'D'
    )
    WHERE material_id = '0000001'
);
----
2

# Test 12: Results are consistent across multiple calls
query I
SELECT (
    SELECT COUNT(*) FROM sap_to_materials_with_desc(
        mara_table := 'test_mara',
        makt_table := 'test_makt',
        language := 'E'
    )
) = (
    SELECT COUNT(*) FROM sap_to_materials_with_desc(
        mara_table := 'test_mara',
        makt_table := 'test_makt',
        language := 'E'
    )
);
----
true

# ============================================================================
# Cleanup
# ============================================================================

statement ok
DROP TABLE test_mara;

statement ok
DROP TABLE test_makt;

# ============================================================================
# language: SAP key ('E') and ISO code ('EN') match MAKT.spras in either form
# ============================================================================

statement ok
CREATE TABLE makt_iso AS SELECT * FROM (VALUES
    ('0000001', 'EN', 'Product A', 'PRODUCT A'),
    ('0000001', 'DE', 'Produkt A', 'PRODUKT A'),
    ('0000002', 'en', 'Assembly', 'ASSEMBLY')
) AS t(matnr, spras, maktx, maktg);

statement ok
CREATE TABLE makt_sap AS SELECT * FROM (VALUES
    ('0000001', 'E', 'Product A', 'PRODUCT A'),
    ('0000001', 'D', 'Produkt A', 'PRODUKT A')
) AS t(matnr, spras, maktx, maktg);

query IIIIII
SELECT (SELECT count(*) FROM extract_material_descriptions(makt_table := 'makt_iso', language := 'E')),
       (SELECT count(*) FROM extract_material_descriptions(makt_table := 'makt_iso', language := 'EN')),
       (SELECT count(*) FROM extract_material_descriptions(makt_table := 'makt_sap', language := 'EN')),
       (SELECT count(*) FROM extract_material_descriptions(makt_table := 'makt_sap')),
       (SELECT full_text FROM extract_material_descriptions(makt_table := 'makt_sap', language := 'de')),
       (SELECT count(*) FROM extract_material_descriptions(makt_table := 'makt_sap', language := 'X'));
----
2	2	1	1	Produkt A PRODUKT A	0

statement ok
CREATE TABLE mara_iso AS SELECT * FROM (VALUES
    ('0000001', 'FERT', 'GRP01', '20200115', NULL),
    ('0000002', 'HALB', 'GRP02', '20210301', NULL)
) AS t(matnr, mtart, matkl, ersda, lvorm);

query IT
SELECT count(*), max(description) FROM sap_to_materials_with_desc(mara_table := 'mara_iso', makt_table := 'makt_iso', language := 'D')
WHERE description <> '';
----
1	Produkt A

query I
SELECT count(*) FROM compute_textual_embeddings(makt_table := 'makt_iso', language := 'EN');
----
2

# ============================================================================
# client: MARA/MAKT mandt keeps SAP clients apart (as in sap_to_bom_items)
# ============================================================================

statement ok
CREATE TABLE mara_2c AS SELECT * FROM (VALUES
    ('100', '0000001', 'FERT', 'GRP01', '20200115', NULL),
    ('200', '0000001', 'FERT', 'GRP01', '20200115', NULL),
    ('100', '0000002', 'HALB', 'GRP02', '20210301', 'X')
) AS t(mandt, matnr, mtart, matkl, ersda, lvorm);

statement ok
CREATE TABLE makt_2c AS SELECT * FROM (VALUES
    ('100', '0000001', 'E', 'Pump client 100'),
    ('200', '0000001', 'E', 'Pump client 200')
) AS t(mandt, matnr, spras, maktx);

query TT
SELECT client, description FROM sap_to_materials_with_desc(mara_table := 'mara_2c', makt_table := 'makt_2c')
ORDER BY client;
----
100	Pump client 100
200	Pump client 200

# a MARA without mandt: client NULL and one row per material, even when MAKT has clients
query TT
SELECT client, description FROM sap_to_materials_with_desc(mara_table := 'mara_iso', makt_table := 'makt_2c')
WHERE material_id = '0000001';
----
NULL	Pump client 100

query I
SELECT count(*) FROM sap_to_materials(mara_table := 'mara_2c');
----
2
